<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <View
        android:id="@+id/headerSearch"
        android:layout_width="0dp"
        android:layout_height="160dp"
        android:background="@color/primary_orange"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/ivBackSearch"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/back"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/back_button_desc"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvHeaderSearch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/list_of_meals_by_title"
        android:textColor="@color/text_dark"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/ivBackSearch"
        app:layout_constraintBottom_toBottomOf="@id/headerSearch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/etSearchQuery"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="24dp"
        android:hint="@string/meal_title"
        android:inputType="text"
        app:layout_constraintTop_toBottomOf="@id/headerSearch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnSearchAction" />

    <Button
        android:id="@+id/btnSearchAction"
        android:layout_width="110dp"
        android:layout_height="44dp"
        android:layout_marginEnd="24dp"
        android:backgroundTint="@color/button_yellow"
        android:text="@string/search"
        android:textAllCaps="false"
        android:textColor="@color/text_dark"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="24dp"
        app:layout_constraintTop_toTopOf="@id/etSearchQuery"
        app:layout_constraintBottom_toBottomOf="@id/etSearchQuery"
        app:layout_constraintEnd_toEndOf="parent" />

    <ListView
        android:id="@+id/listViewSearchResults"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/etSearchQuery"
        app:layout_constraintBottom_toTopOf="@id/btnSeeDetails"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnSeeDetails"
        android:layout_width="160dp"
        android:layout_height="48dp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="@color/button_yellow"
        android:text="@string/see_details"
        android:textAllCaps="false"
        android:textColor="@color/text_dark"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
